# ── Server ──────────────────────────────────────────────────
PORT=8181
FRONTEND_ORIGIN=http://localhost:5173

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-string

# ── Neon PostgreSQL ──────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection Details
# Format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional for local dev: leave unset and the backend auto-starts a local
# embedded Postgres on :5433 (data persisted under your user config dir).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── Cloudflare R2 ────────────────────────────────────────────
# Account ID: Cloudflare dashboard → right sidebar
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API Token credentials:
# Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API Token
# Give it: Object Read & Write on your bucket
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket name you created in R2
R2_BUCKET_NAME=memoera-assets

# Public URL for the bucket (enable "Public Access" on the bucket in R2 dashboard)
# It will look like: https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ── Email OTP (optional for local dev — OTP prints to terminal if not set) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com

# ── SMS OTP via Twilio (optional for local dev) ──────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# ── Razorpay (Standard Checkout) ─────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_CALLBACK_URL=https://your-frontend.example.com/payment-success

# -- Admin ------------------------------------------------------
# Must match VITE_ADMIN_EMAIL in webar-app/.env.local -- grants the Admin
# Panel and bypasses personal storage quota for global content uploads.
ADMIN_EMAIL=your-admin@email.com

# -- OpenAI (content moderation) --------------------------------
# Same key as OPENAI_API_KEY in webar-backend/.env. Used server-side to
# moderate every image before a target can be made Public — see moderation.go.
OPENAI_API_KEY=sk-...
