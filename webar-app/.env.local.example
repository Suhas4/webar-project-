# Copy this to .env.local and fill in your values.
# VITE_ prefix is required for Vite to expose vars to the browser.

# Local development (Go backend running on your machine)
VITE_API_BASE=http://localhost:8181

# For mobile testing via ngrok tunnel:
# VITE_API_BASE=https://xxxx.ngrok-free.app

# Production:
# VITE_API_BASE=https://webar-project-8jbi.onrender.com

# ── Google AdMob (mobile app ads) — get real values from apps.admob.com ──────
# Leave unset to use Google's public test ad units (safe default for dev).
# VITE_ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
# VITE_ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
